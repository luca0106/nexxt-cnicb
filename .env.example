# Configurație Bază de Date PostgreSQL
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=bankpassword
POSTGRES_DB=bankdesk
DATABASE_URL=postgresql://bankuser:bankpassword@postgres:5432/bankdesk

# Porturi expuse pe host
FRONTEND_PORT=3001
BACKEND_PORT=8000

# ========================================================
# AWS Bedrock / AI Gateway (Hackathon AI Agents API)
# ========================================================
# Pune URL-ul primit de la organizatori (ex: https://...amazonaws.com/...):
AWS_API_URL=https://example-api-id.execute-api.eu-central-1.amazonaws.com/prod/agent

# Pune API Key-ul primit:
AWS_API_KEY=your_aws_api_key_here

# Model ID (opțional, default claude-3-5-sonnet):
AWS_MODEL_ID=anthropic.claude-3-5-sonnet
